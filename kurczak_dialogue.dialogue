INCLUDE globals.ink

~ start
if completed_babcia == true and fed_the_chickens == false
	Ty: Dobrze byłoby pomóc pani Krysi.
	Ty: Biedna… Na stare lata dalej sama musi karmić kurczaki.
		- Nakarm kurczaki.
		Ty: Dam wam jeść.
		Zadanie: *Karmisz kurczaki.*
		Ty: Jesteście bardzo urocze.
		Ty: Mam nadzieję, że niedługo też będę mieć małego kurczaczka.
		Zadanie: *Nachylasz się nad płotem i głaszczesz kurczaka pani Krysi.*
		Ty: Macie bardzo przyjemne w dotyku pióra.
		~fed_the_chickens = true
		=> END

elif onQuest_babcia == false
	Ty: Pani Krysia ma dużo kurczaków.
	Ty: Wyglądacie na głodne.
	=> END

elif completed_babcia == true and fed_the_chickens == true
	Ty: Już dostałyście jedzenie.
	=> END

else
	Ty: Niedługo dostaniecie jeść!
	=> END
